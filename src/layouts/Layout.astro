---
import '@chirag127/oz-tokens-base';
import '@chirag127/oz-chrome/styles.css';
import '../styles/theme.css';
import '../styles/studio.css';
import OzHeader from '@chirag127/oz-chrome/components/OzHeader.astro';
import OzFooter from '@chirag127/oz-chrome/components/OzFooter.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'oriz.persona — AI character chat & roleplay, free, no signup',
  description = 'Free AI character chat: build a persona with name, traits & voice, roleplay in speech-bubble chat, save & share by link. 100% in your browser, no signup, no upload.',
} = Astro.props;
const canonical = 'https://persona.oriz.in/';
const ogImage = 'https://persona.oriz.in/icons/icon-512.png';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'oriz.persona',
  description,
  applicationCategory: 'EntertainmentApplication',
  operatingSystem: 'Web',
  url: canonical,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ff2d93" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <script is:inline src="/registerSW.js"></script>
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <a class="oz-skip-link" href="#main">Skip to content</a>
    <OzHeader site="persona" title="AI character chat">
      <a href="https://oriz.in" class="pbtn pbtn--ghost" style="padding:.35rem .8rem">oriz.in</a>
    </OzHeader>
    <main id="main" tabindex="-1" class="wrap">
      <slot />
    </main>
    <OzFooter>
      <a href="https://github.com/chirag127/oriz-persona">Source</a>
      <span aria-hidden="true"> · </span>
      <span>100% client-side · no signup</span>
    </OzFooter>

    <style is:global>
      .wrap { max-width: 980px; margin: 0 auto; padding: 1.5rem 1.1rem 4rem; }
      .oz-footer { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;
        padding: 1.2rem 1.1rem; border-top: 1px solid var(--oz-rule);
        max-width: 980px; margin: 0 auto; color: var(--oz-ink-mute); font-size: .85rem; }
      .oz-footer__links { display: flex; gap: .4rem; align-items: center; flex-wrap: wrap; }
    </style>
  </body>
</html>
